{
  "components": {
    "schemas": {
      "CreateJobRequest": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "YouTube video link",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "CreateJobRequest",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "JobResponse": {
        "properties": {
          "duration_s": {
            "title": "Duration S",
            "type": "number"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "estimated_wait_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Wait S"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "0 = processing, 1 = next; null once it left the queue",
            "title": "Position"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        },
        "required": [
          "job_id",
          "status",
          "duration_s"
        ],
        "title": "JobResponse",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "downloading",
          "transcribing",
          "scoring",
          "done",
          "failed",
          "expired"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "NoteOut": {
        "properties": {
          "end_s": {
            "title": "End S",
            "type": "number"
          },
          "pitch": {
            "maximum": 127.0,
            "minimum": 0.0,
            "title": "Pitch",
            "type": "integer"
          },
          "start_s": {
            "title": "Start S",
            "type": "number"
          },
          "velocity": {
            "maximum": 127.0,
            "minimum": 0.0,
            "title": "Velocity",
            "type": "integer"
          }
        },
        "required": [
          "pitch",
          "start_s",
          "end_s",
          "velocity"
        ],
        "title": "NoteOut",
        "type": "object"
      },
      "ResultMeta": {
        "properties": {
          "duration_s": {
            "title": "Duration S",
            "type": "number"
          },
          "note_count": {
            "title": "Note Count",
            "type": "integer"
          }
        },
        "required": [
          "duration_s",
          "note_count"
        ],
        "title": "ResultMeta",
        "type": "object"
      },
      "ResultResponse": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/ResultMeta"
          },
          "notes": {
            "items": {
              "$ref": "#/components/schemas/NoteOut"
            },
            "title": "Notes",
            "type": "array"
          }
        },
        "required": [
          "meta",
          "notes"
        ],
        "title": "ResultResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Pianola API",
    "version": "1"
  },
