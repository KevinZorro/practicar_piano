{
  "components": {
    "schemas": {
      "CreateJobRequest": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "YouTube video link",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["url"],
        "title": "CreateJobRequest",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": ["error"],
        "title": "ErrorResponse",
        "type": "object"
      },
      "JobResponse": {
        "properties": {
          "duration_s": {
            "title": "Duration S",
            "type": "number"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "estimated_wait_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Wait S"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "0 = processing, 1 = next; null once it left the queue",
            "title": "Position"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        },
        "required": ["job_id", "status", "duration_s"],
        "title": "JobResponse",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "downloading",
          "transcribing",
          "scoring",
          "done",
          "failed",
          "expired"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "LevelOut": {
        "properties": {
          "max_polyphony_after": {
            "title": "Max Polyphony After",
            "type": "integer"
          },
          "max_polyphony_before": {
            "title": "Max Polyphony Before",
            "type": "integer"
          },
          "name": {
            "enum": ["original", "playable", "easy"],
            "title": "Name",
            "type": "string"
          },
          "notes": {
            "items": {
              "$ref": "#/components/schemas/NoteOut"
            },
            "title": "Notes",
            "type": "array"
          },
          "notes_dropped_ratio": {
            "title": "Notes Dropped Ratio",
            "type": "number"
          },
          "score": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent for the original level"
          }
        },
        "required": [
          "name",
          "notes",
          "notes_dropped_ratio",
          "max_polyphony_before",
          "max_polyphony_after"
        ],
        "title": "LevelOut",
        "type": "object"
      },
      "MeasureOut": {
        "properties": {
          "measure": {
            "description": "1-based, as in the MusicXML",
            "minimum": 1.0,
            "title": "Measure",
            "type": "integer"
          },
          "start_s": {
            "description": "Seconds from the start of the video",
            "title": "Start S",
            "type": "number"
          }
        },
        "required": ["measure", "start_s"],
        "title": "MeasureOut",
        "type": "object"
      },
      "NoteOut": {
        "properties": {
          "end_s": {
            "title": "End S",
            "type": "number"
          },
          "pitch": {
            "maximum": 127.0,
            "minimum": 0.0,
            "title": "Pitch",
            "type": "integer"
          },
          "start_s": {
            "title": "Start S",
            "type": "number"
          },
          "velocity": {
            "maximum": 127.0,
            "minimum": 0.0,
            "title": "Velocity",
            "type": "integer"
          }
        },
        "required": ["pitch", "start_s", "end_s", "velocity"],
        "title": "NoteOut",
        "type": "object"
      },
      "ResultMeta": {
        "properties": {
          "duration_s": {
            "title": "Duration S",
            "type": "number"
          },
          "tempo_bpm": {
            "title": "Tempo Bpm",
            "type": "number"
          },
          "tempo_confidence": {
            "enum": ["high", "low"],
            "title": "Tempo Confidence",
            "type": "string"
          }
        },
        "required": ["duration_s", "tempo_bpm", "tempo_confidence"],
        "title": "ResultMeta",
        "type": "object"
      },
      "ResultResponse": {
        "properties": {
          "levels": {
            "items": {
              "$ref": "#/components/schemas/LevelOut"
            },
            "title": "Levels",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/ResultMeta"
          }
        },
        "required": ["meta", "levels"],
        "title": "ResultResponse",
        "type": "object"
      },
      "ScoreOut": {
        "properties": {
          "measures": {
            "items": {
              "$ref": "#/components/schemas/MeasureOut"
            },
            "title": "Measures",
            "type": "array"
          },
          "musicxml": {
            "title": "Musicxml",
            "type": "string"
          },
          "tempo_bpm": {
            "title": "Tempo Bpm",
            "type": "number"
          }
        },
        "required": ["musicxml", "tempo_bpm", "measures"],
        "title": "ScoreOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Pianola API",
    "version": "1"
  },
