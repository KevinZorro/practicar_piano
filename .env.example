# Optional proxy for yt-dlp (e.g. WireGuard-connected home proxy). Leave empty for direct download.
# Home proxy over WireGuard: socks5h://10.8.0.2:1080 (socks5h resolves DNS at the proxy).
# Also valid: http://10.8.0.2:3128. See docs/phase-0/proxy-casa-wireguard.md
PIANOLA_PROXY_URL=
# Max audio duration accepted, in seconds
PIANOLA_MAX_DURATION_SECONDS=600
